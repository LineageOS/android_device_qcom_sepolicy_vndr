vndbinder_use(vendor_qcc_trd_2)

allow vendor_qcc_trd_2 vendor_qccvendor_data_file:file create_file_perms;
allow vendor_qcc_trd_2 vendor_qccvendor_data_file:dir create_dir_perms;

# allow qcc_prop
set_prop(vendor_qcc_trd_2, vendor_qcc_prop);

# allow qcc-trd to add qccvndhal service to hwservicemanager
hal_server_domain(vendor_qcc_trd_2, vendor_hal_qccvndhal)
hal_attribute_hwservice(vendor_hal_qccvndhal, vendor_hal_qccvndhal_hwservice)

#Allow hwbinder call from hal client to server
binder_call(vendor_hal_qccvndhal_client, vendor_hal_qccvndhal_server)
binder_call(vendor_hal_qccvndhal_server, vendor_hal_qccvndhal_client)
