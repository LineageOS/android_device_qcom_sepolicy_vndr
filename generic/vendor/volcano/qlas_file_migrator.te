# qlas_file_migrator - One-shot service to migrate qlas files from vendor to persist

type vendor_qlas_file_migrator, domain;
type vendor_qlas_file_migrator_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_qlas_file_migrator)


allow vendor_qlas_file_migrator vendor_qlas_migration_config:file r_file_perms;
allow vendor_qlas_file_migrator vendor_qlas_conf_file:dir { r_dir_perms };
allow vendor_qlas_file_migrator vendor_qlas_conf_file:file { r_file_perms };
allow vendor_qlas_file_migrator mnt_vendor_file:dir { search getattr };


allow vendor_qlas_file_migrator vendor_qlas_persist_data_file:dir { create_dir_perms };
allow vendor_qlas_file_migrator vendor_qlas_persist_data_file:file { create_file_perms };

unix_socket_connect(vendor_qlas_file_migrator, vendor_ssgtzd, vendor_ssgtzd)
allow vendor_qlas_file_migrator vendor_persist_data_file:dir {search};

set_prop(vendor_qlas_file_migrator, vendor_qlas_migrated_prop)
set_prop(vendor_qlas_file_migrator, vendor_qlas_migrated_files_prop)

userdebug_or_eng(`
    get_prop(vendor_qlas_file_migrator, vendor_mink_trace_prop)
')

