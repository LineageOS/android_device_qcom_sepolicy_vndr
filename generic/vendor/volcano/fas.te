type vendor_fas, domain;
type vendor_fas_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_fas)

# Sepolicy rules for FAS service
allow vendor_fas vendor_fas_socket:dir w_dir_perms;
allow vendor_fas vendor_fas_socket:sock_file {create unlink write};
unix_socket_connect(vendor_fas, vendor_ssgtzd, vendor_ssgtzd)
allow vendor_fas mnt_vendor_file:dir {search};
allow vendor_fas vendor_persist_data_file:dir {search};
allow vendor_fas vendor_fas_persist_data_file:file rw_file_perms;
allow vendor_fas vendor_fas_persist_data_file:dir rw_dir_perms;
allow vendor_fas proc_version:file r_file_perms;
allow vendor_fas vendor_qrsloader:unix_dgram_socket sendto;
net_domain(vendor_fas);

userdebug_or_eng(`
    get_prop(vendor_fas,vendor_mink_trace_prop)
')
